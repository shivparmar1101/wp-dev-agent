{
  "name": "wp-dev-agent",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub-based AI WordPress/Elementor development agent (Foundation MVP)",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": ".\\.venv\\Scripts\\python.exe -m uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": ".\\.venv\\Scripts\\python.exe -m pytest tests -q",
    "test:frontend": "npm --prefix frontend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
