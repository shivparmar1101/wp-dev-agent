# ---------------------------------------------------------------------------
# WP Dev Agent - environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME="WP Dev Agent"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- GitHub OAuth -----------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Minimum read permissions: `repo` (private repo read access) + `read:user`.
GITHUB_SCOPE=repo read:user

# --- AI provider ------------------------------------------------------------
# Provider: openai | anthropic | gemini | mock
# `openai` also works with any OpenAI-compatible endpoint (OpenRouter, Groq,
# Ollama, DeepSeek, ...) via AI_BASE_URL.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# --- Database / persistence -------------------------------------------------
# SQLite is supported out of the box. Other URLs are reserved for later phases.
DATABASE_URL=sqlite:///./data/wp_dev_agent.db
# Used to encrypt stored GitHub tokens at rest. Auto-generated into
# ./data/secret.key when left empty.
SECRET_KEY=

# --- Session ----------------------------------------------------------------
SESSION_COOKIE_NAME=wpdev_session
SESSION_TTL_SECONDS=604800

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_REQUESTS=15
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Scanning / indexing ----------------------------------------------------
# Comma separated directory (or path fragment) names that are never scanned.
IGNORED_PATHS=.git,node_modules,vendor,dist,build,.cache,.next,.nuxt,coverage,.idea,.vscode,__pycache__,.venv,venv,target,tmp,wp-content/cache,wp-content/uploads
MAX_FILE_BYTES=1500000
MAX_INDEX_FILE_BYTES=400000
MAX_INDEXED_FILES=2500
CHUNK_MAX_LINES=120
CHUNK_OVERLAP_LINES=20
AI_CONTEXT_FILES=8
AI_CONTEXT_CHUNKS=14
AI_CONTEXT_CHAR_BUDGET=14000
